# Copy to `.env`. Read by `docker compose` (to fill `${...}` in docker-compose.yml) and by
# `pnpm dev` — the container itself only sees the variables docker-compose.yml passes it.

# Anthropic API key. Unset = Anthropic contributes no models.
# example: ANTHROPIC_API_KEY='your-api-key'
ANTHROPIC_API_KEY=

# Dev only: when true, `pnpm dev` wipes the dev db before pushing + reseeding on every start.
DB_WIPE_ON_START=true
