{
	"name": "shinrin",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"engines": {
		"node": ">=26 <27"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "tsx scripts/dev.ts",
		"dev-debug": "LOG_LEVEL=debug tsx scripts/dev.ts",
		"dev-trace": "LOG_LEVEL=trace tsx scripts/dev.ts",
		"mcp:server": "tsx scripts/mcp-server.ts",
		"build": "vite build",
		"start": "NODE_ENV=production node build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"verify": "pnpm run check && pnpm run lint",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "pnpm run test:unit -- --run && pnpm run test:e2e",
		"test:e2e": "playwright install && playwright test",
		"db:dev:push": "drizzle-kit push --force",
		"db:dev:studio": "drizzle-kit studio",
		"db:dev:seed": "tsx src/lib/server/db/seed.ts",
		"db:dev:clean": "tsx src/lib/server/db/clean.ts",
		"db:prod:generate": "drizzle-kit generate --config drizzle.config.prod.ts",
		"db:prod:migrate": "drizzle-kit migrate --config drizzle.config.prod.ts",
		"db:prod:studio": "drizzle-kit studio --config drizzle.config.prod.ts"
	},
	"dependencies": {
		"@modelcontextprotocol/server": "^2.0.0",
		"@mozilla/readability": "^0.6.0",
		"@valibot/to-json-schema": "^1.7.1",
		"better-sqlite3": "^13.0.3",
		"dotenv": "^17.4.2",
		"drizzle-valibot": "^0.4.2",
		"jsdom": "^30.0.1",
		"ky": "^2.0.2",
		"mode-watcher": "^1.1.0",
		"ollama": "^0.6.3",
		"pino": "^10.3.1",
		"turndown": "^7.2.4",
		"valibot": "^1.4.1"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@fontsource-variable/inter": "^5.2.8",
		"@internationalized/date": "^3.12.2",
		"@lucide/svelte": "^1.31.0",
		"@playwright/test": "^1.60.0",
		"@sveltejs/adapter-node": "6.0.0-next.10",
		"@sveltejs/kit": "3.0.0-next.23",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.2.2",
		"@types/better-sqlite3": "^9.6.0",
		"@types/jsdom": "^30.0.0",
		"@types/node": "^26.2.0",
		"@types/turndown": "^5.0.6",
		"@vitest/browser-playwright": "^4.1.3",
		"bits-ui": "^2.18.1",
		"clsx": "^2.1.1",
		"drizzle-kit": "^0.31.10",
		"drizzle-orm": "^0.45.2",
		"eslint": "^10.4.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.20.0",
		"globals": "^17.4.0",
		"pino-pretty": "^13.1.3",
		"playwright": "^1.60.0",
		"prettier": "^3.8.1",
		"prettier-plugin-svelte": "^3.5.1",
		"prettier-plugin-tailwindcss": "^0.7.2",
		"shadcn-svelte": "^1.3.0",
		"svelte": "^5.56.5",
		"svelte-check": "^4.4.6",
		"svelte-sonner": "^1.1.1",
		"tailwind-merge": "^3.6.0",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.2.2",
		"tsx": "^4.19.4",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.2",
		"typescript-eslint": "^8.58.1",
		"vite": "^8.1.5",
		"vitest": "^4.1.3",
		"vitest-browser-svelte": "^2.1.0"
	}
}
